<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Totem SEDUC</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f3f4f6; }
        .bg-senai { background-color: #005CAA; }
        .text-senai { color: #005CAA; }
        .border-red-senai { border-color: #E3000F; }
        
        .pulse-dot {
            height: 12px; width: 12px; background-color: #10B981; border-radius: 50%;
            display: inline-block; margin-right: 8px; box-shadow: 0 0 8px #10B981;
            animation: pulse 2s infinite;
        }
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
        
        .linha-aula { animation: slideIn 0.8s ease-out forwards; opacity: 0; transform: translateY(10px); }
        @keyframes slideIn { to { opacity: 1; transform: translateY(0); } }

        /* Estilos adicionais para a paginação e transições suaves */
        .page-indicator {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: #d1d5db;
            margin: 0 5px;
            transition: background-color 0.3s, transform 0.3s;
        }
        .page-indicator.active {
            background-color: #005CAA;
            transform: scale(1.3);
        }
    </style>
</head>
<body class="h-screen w-screen overflow-hidden flex flex-col">
    <!-- Cabeçalho -->
    <header class="bg-senai text-white p-6 flex justify-between items-center shadow-lg">
        <div class="flex items-center gap-4">
            <div class="text-4xl font-black tracking-wider">SENAI</div>
            <div class="text-2xl font-light border-l-2 pl-4 border-white">Cronograma de Aulas - SEDUC</div>
        </div>
        <div class="text-right flex flex-col items-end">
            <div id="relogio" class="text-4xl font-bold tracking-wider">00:00:00</div>
            <div id="data-atual" class="text-xl uppercase text-gray-200">Carregando...</div>
        </div>
    </header>

    <!-- Conteúdo Central -->
    <main class="flex-1 p-8 flex flex-col">
        <div class="flex justify-between items-end mb-6 border-b-4 border-red-senai pb-2">
            <h2 id="dia-semana-titulo" class="text-4xl font-bold text-senai tracking-tight">AULAS DE HOJE</h2>
            <div class="flex items-center text-sm font-semibold text-gray-500">
                <span class="pulse-dot"></span> Sincronizado ao vivo
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-2xl flex-1 flex flex-col overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-800 text-white text-xl uppercase tracking-wider">
                        <th class="p-4 pl-6 w-1/5">Escola</th>
                        <th class="p-4 w-1/4">Curso (Série)</th>
                        <th class="p-4 w-1/5">Instrutor(a)</th>
                        <th class="p-4 w-1/5">Ambiente</th>
                        <th class="p-4 text-center w-24">Lanche</th>
                        <th class="p-4 text-center w-24 pr-6">Saída</th>
                    </tr>
                </thead>
                <tbody id="tabela-corpo" class="text-xl transition-opacity duration-500">
                    <!-- Linhas preenchidas pelo robô automaticamente -->
                </tbody>
            </table>
            
            <!-- Controles de Paginação -->
            <div id="paginacao" class="mt-auto py-4 bg-gray-100 border-t border-gray-200 flex justify-center items-center h-12">
                <!-- Bolinhas de paginação aparecerão aqui -->
            </div>
        </div>
    </main>

    <script>
        // ======= A SUA URL JÁ ESTÁ CONFIGURADA AQUI =======
        const API_URL = "https://script.google.com/macros/s/AKfycbxnj9CxtM0gWUtGVgH9jYH_ilm-zeHhYrobSCaL57gIwotV061khokMJt64NHRhSqxGFA/exec"; 
        // ====================================================

        const diasDaSemana = ["DOMINGO", "SEGUNDA", "TERÇA", "QUARTA", "QUINTA", "SEXTA", "SÁBADO"];
        let dadosCompletos = {};
        
        // --- CONFIGURAÇÕES DE PAGINAÇÃO ---
        const LINHAS_POR_PAGINA = 8; // Número de turmas por tela (ajuste se precisar)
        const TEMPO_POR_PAGINA_MS = 10000; // Tempo que cada página fica na tela (10 segundos)
        
        let paginaAtual = 0;
        let totalPaginas = 1;
        let aulasDoDia = [];
        let timerPaginacao;

        function atualizarRelogio() {
            const agora = new Date();
            document.getElementById('relogio').innerText = agora.toLocaleTimeString('pt-BR');
            const opcoesData = { weekday: 'long', day: '2-digit', month: 'long' };
            document.getElementById('data-atual').innerText = agora.toLocaleDateString('pt-BR', opcoesData);
        }

        async function buscarDados() {
            if(!API_URL.startsWith("http")) return;
            try {
                const resposta = await fetch(API_URL);
                dadosCompletos = await resposta.json();
                prepararDadosDoDia();
            } catch (erro) {
                console.error("Erro ao sincronizar com a planilha:", erro);
            }
        }

        function prepararDadosDoDia() {
            let hoje = new Date().getDay();
            if (hoje === 0 || hoje === 6) hoje = 1; // Fim de semana mostra segunda
            
            const nomeDia = diasDaSemana[hoje];
            document.getElementById('dia-semana-titulo').innerText = `AULAS DE HOJE - ${nomeDia}`;

            aulasDoDia = dadosCompletos[nomeDia] || [];
            
            // Calcula o número de páginas
            totalPaginas = Math.ceil(aulasDoDia.length / LINHAS_POR_PAGINA);
            if (totalPaginas === 0) totalPaginas = 1;
            
            // Reseta a paginação ao atualizar os dados
            paginaAtual = 0;
            
            // Limpa o timer anterior se existir
            if (timerPaginacao) clearInterval(timerPaginacao);
            
            // Renderiza a primeira página
            renderizarPaginaAtual();
            
            // Inicia o carrossel se tiver mais de uma página
            if (totalPaginas > 1) {
                document.getElementById('paginacao').style.display = 'flex';
                timerPaginacao = setInterval(proximaPagina, TEMPO_POR_PAGINA_MS);
            } else {
                document.getElementById('paginacao').style.display = 'none';
            }
        }

        function proximaPagina() {
            const corpo = document.getElementById('tabela-corpo');
            
            // Efeito de fade out
            corpo.style.opacity = "0";
            
            setTimeout(() => {
                paginaAtual++;
                if (paginaAtual >= totalPaginas) {
                    paginaAtual = 0; // Volta para a primeira página
                }
                
                renderizarPaginaAtual();
                
                // Efeito de fade in
                corpo.style.opacity = "1";
            }, 500); // Aguarda meio segundo para trocar o conteúdo enquanto a tela está invisível
        }

        function renderizarPaginaAtual() {
            const corpo = document.getElementById('tabela-corpo');
            corpo.innerHTML = ""; 

            if (!aulasDoDia || aulasDoDia.length === 0) {
                corpo.innerHTML = `<tr><td colspan="6" class="p-8 text-center text-gray-500 text-2xl font-medium">Nenhuma aula encontrada para o dia de hoje.</td></tr>`;
                atualizarBolinhas();
                return;
            }

            // Pega apenas as aulas da página atual (fatia da lista)
            const inicio = paginaAtual * LINHAS_POR_PAGINA;
            const fim = inicio + LINHAS_POR_PAGINA;
            const aulasDaPagina = aulasDoDia.slice(inicio, fim);

            aulasDaPagina.forEach((aula, index) => {
                const tr = document.createElement('tr');
                tr.className = `border-b border-gray-200 linha-aula ${index % 2 === 0 ? 'bg-gray-50' : 'bg-white'}`;
                tr.style.animationDelay = `${index * 0.05}s`; // Animação mais rápida na paginação

                tr.innerHTML = `
                    <td class="p-4 pl-6 font-bold text-gray-800">${aula.escola}</td>
                    <td class="p-4"><span class="text-senai font-bold">${aula.curso}</span> <span class="text-sm bg-gray-200 text-gray-700 px-2 py-1 rounded ml-2 font-bold">${aula.serie}</span></td>
                    <td class="p-4 font-medium uppercase">${aula.instrutor}</td>
                    <td class="p-4 font-medium text-gray-700">${aula.ambiente}</td>
                    <td class="p-4 text-center font-bold text-green-600">${aula.lanche}</td>
                    <td class="p-4 text-center font-bold text-red-600 pr-6">${aula.saida}</td>
                `;
                corpo.appendChild(tr);
            });
            
            atualizarBolinhas();
        }
        
        function atualizarBolinhas() {
            const container = document.getElementById('paginacao');
            container.innerHTML = '';
            
            if (totalPaginas <= 1) return;
            
            for (let i = 0; i < totalPaginas; i++) {
                const bolinha = document.createElement('div');
                bolinha.className = `page-indicator ${i === paginaAtual ? 'active' : ''}`;
                container.appendChild(bolinha);
            }
        }

        // Relógio roda a cada segundo
        setInterval(atualizarRelogio, 1000);
        atualizarRelogio();

        // O robô de buscas: de 5 em 5 minutos a página "puxa" os novos dados da sua planilha 
        if (API_URL.startsWith("http")) {
            buscarDados();
            setInterval(buscarDados, 300000); 
            setInterval(prepararDadosDoDia, 60000); // Checa todo minuto se o dia já virou
        } else {
            document.getElementById('tabela-corpo').innerHTML = `<tr><td colspan="6" class="p-8 text-center text-red-600 text-2xl font-bold">⚠️ Atenção: Não esqueça de colar a URL do Apps Script dentro do arquivo HTML!</td></tr>`;
        }
    </script>
</body>
</html>
